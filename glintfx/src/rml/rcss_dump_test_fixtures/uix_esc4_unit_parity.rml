<rml><head><style>
body { font-size: 20px; }
#mid { font-size: 50px; }
#a { font-size: 2rem; }
#b { margin-top: 2em; }
#c { width: 50vw; }
#d { height: 50vh; }
#e { border-top-width: 1in; }
#f { border-bottom-width: 1cm; }
#g { column-gap: 1mm; }
#h { row-gap: 1pt; }
#i { scrollbar-margin: 1pc; }
#j { margin-left: 1.5rem; }
</style></head><body>
<div id="mid"><div id="a"></div></div>
<div id="b"></div>
<div id="c"></div>
<div id="d"></div>
<div id="e"></div>
<div id="f"></div>
<div id="g"></div>
<div id="h"></div>
<div id="i"></div>
<div id="j"></div>
</body></rml>
